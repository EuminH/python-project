# Copy this file to `.streamlit/secrets.toml` for local use, OR paste these
# lines into the "Secrets" box of your Streamlit Community Cloud app settings.
# Never commit the real secrets.toml — it is gitignored.

ODDS_API_KEY = "your_the_odds_api_key_here"

# Optional: require a password to use the app (protects your API quota on a
# public URL). Remove or leave unset for no password gate.
# APP_PASSWORD = "choose-a-password"

# Optional: OddsJam premium odds feed (paid — developer.oddsjam.com). When
# set, it becomes the primary odds source with more books in the consensus.
# ODDSJAM_API_KEY = "your_oddsjam_key"
